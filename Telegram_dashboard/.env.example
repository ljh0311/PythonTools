TELEGRAM_BOT_TOKEN=your-telegram-bot-token
TELEGRAM_WEBHOOK_SECRET=change-me-to-a-random-secret
# Local dev: poll Telegram for new messages (no ngrok). Disable in production (use webhook).
TELEGRAM_POLLING=true

# Which provider to try first: gemini | ollama
# Default gemini; on 429/errors the other provider is tried (keys redacted in UI).
# Local digest iteration: set AI_PRIMARY_PROVIDER=ollama to avoid Gemini rate limits.
AI_PRIMARY_PROVIDER=gemini

# Google Gemini (https://aistudio.google.com/apikey)
# Leave unset or use a placeholder to skip Gemini.
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-3.6-flash

# Local Ollama (https://ollama.ai) — fallback when Gemini fails or is unset
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=qwen2.5:3b

DASHBOARD_API_KEY=dev-dashboard-key

# v0.2 User inbox — get api_id + api_hash from https://my.telegram.org
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
MTPROTO_ENABLED=false
MTPROTO_PHONE=
# MTPROTO_SESSION_NAME=user.session

# Human login (browser). Leave OPERATOR_PASSWORD empty for dev API-key-only mode.
OPERATOR_USERNAME=admin
OPERATOR_PASSWORD=change-me-to-a-strong-password
SESSION_TTL_HOURS=24

AUTO_REPLY_MODE=manual
TOPIC_MODE=user_type
SUMMARY_CACHE_TTL=3600
AI_RATE_LIMIT_PER_MINUTE=10
REDACTION_EXTRA_PATTERNS=

# Optional SmartPersona brain for learn-from-chat (requires Ollama when enabled)
SMARTPERSONA_ENABLED=false
# SMARTPERSONA_PATH=../SmartPersona

# OpenClaw (optional — configure matching values in openclaw.json skills.entries)
OPENCLAW_ENABLED=false
OPENCLAW_GATEWAY_URL=http://127.0.0.1:18789

HOST=0.0.0.0
PORT=8000
OLLAMA_FALLBACK_MODELS=qwen2.5:3b,qwen2.5,llama3.1:8b

# Needs-reply digest (bot → operator chat). Reuses Act open-items heuristic.
# Requires TELEGRAM_BOT_TOKEN + a chat id. Dev: prefer AI_PRIMARY_PROVIDER=ollama.
UNREAD_DIGEST_ENABLED=false
# Defaults to NOTIFY_TELEGRAM_CHAT_ID when UNREAD_DIGEST_CHAT_ID is empty
NOTIFY_TELEGRAM_CHAT_ID=
UNREAD_DIGEST_CHAT_ID=
UNREAD_DIGEST_INTERVAL_MIN=180
UNREAD_DIGEST_MAX_THREADS=8
# Optional quiet hours (local clock, 0-23). Example: 23 → 7
# UNREAD_DIGEST_QUIET_START=23
# UNREAD_DIGEST_QUIET_END=7
